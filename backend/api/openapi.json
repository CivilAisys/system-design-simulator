{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "System Design Simulator API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/v1/simulate" : {
      "post" : {
        "tags" : [ "simulate-controller" ],
        "operationId" : "simulate",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/Topology"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SimulationResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "Edge" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "source" : {
            "type" : "string"
          },
          "target" : {
            "type" : "string"
          },
          "weight" : {
            "type" : "number",
            "format" : "double",
            "default" : 1
          },
          "callsPerRequest" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 1
          },
          "latencyMs" : {
            "type" : "number",
            "format" : "double",
            "default" : 1,
            "description" : "往返的網路延遲：送出請求到收到回應，在網路上花的時間"
          },
          "requestClass" : {
            "type" : "string",
            "default" : "ALL",
            "description" : "只用在 Service 的邊：哪個 class 的請求會呼叫這個下游",
            "enum" : [ "ALL", "READ", "WRITE" ]
          }
        },
        "required" : [ "id", "source", "target" ]
      },
      "Node" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "enum" : [ "CLIENT", "LOAD_BALANCER", "SERVICE", "CACHE", "CDN", "DATABASE", "OBJECT_STORAGE", "RATE_LIMITER", "EXTERNAL_API", "READ_REPLICA", "MESSAGE_QUEUE" ]
          },
          "name" : {
            "type" : "string"
          },
          "params" : {
            "$ref" : "#/components/schemas/NodeParams"
          },
          "state" : {
            "type" : "string",
            "enum" : [ "HEALTHY" ]
          },
          "ui" : {
            "$ref" : "#/components/schemas/NodeUi"
          }
        },
        "required" : [ "id", "name", "params", "type" ]
      },
      "NodeParams" : {
        "type" : "object",
        "properties" : {
          "rps" : {
            "type" : "number",
            "format" : "double",
            "description" : "CLIENT"
          },
          "readRatio" : {
            "type" : "number",
            "format" : "double",
            "description" : "CLIENT"
          },
          "readResponseBytes" : {
            "type" : "number",
            "format" : "double",
            "description" : "CLIENT：每個 read 回應的大小（bytes），只用來估算頻寬，省略時為 10000"
          },
          "writeRequestBytes" : {
            "type" : "number",
            "format" : "double",
            "description" : "CLIENT：每個 write 上傳的大小（bytes），只用來估算頻寬，省略時為 1000"
          },
          "instances" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "LOAD_BALANCER, SERVICE, CACHE, CDN, DATABASE, OBJECT_STORAGE, READ_REPLICA, MESSAGE_QUEUE"
          },
          "concurrency" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "LOAD_BALANCER, SERVICE, CACHE, CDN, DATABASE, OBJECT_STORAGE, READ_REPLICA, MESSAGE_QUEUE"
          },
          "serviceTimeMs" : {
            "type" : "number",
            "format" : "double",
            "description" : "LOAD_BALANCER, SERVICE, CACHE, CDN, DATABASE, OBJECT_STORAGE, READ_REPLICA, MESSAGE_QUEUE"
          },
          "callMode" : {
            "type" : "string",
            "description" : "SERVICE",
            "enum" : [ "SEQUENTIAL", "PARALLEL" ]
          },
          "hitRatio" : {
            "type" : "number",
            "format" : "double",
            "description" : "CACHE, CDN"
          },
          "limitRps" : {
            "type" : "number",
            "format" : "double",
            "description" : "RATE_LIMITER"
          },
          "latencyMs" : {
            "type" : "number",
            "format" : "double",
            "description" : "EXTERNAL_API：固定的回應時間"
          },
          "quotaRps" : {
            "type" : "number",
            "format" : "double",
            "description" : "EXTERNAL_API：對方給的配額"
          },
          "hotShare" : {
            "type" : "number",
            "format" : "double",
            "description" : "CACHE：最熱的那台分到的流量比例（1/instances ～ 1），省略時所有機器共用一條佇列"
          },
          "replicas" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "CACHE：每個主有幾個從（0 ～ 5），只是標記、不影響計算，省略時為 0"
          },
          "bytesPerWrite" : {
            "type" : "number",
            "format" : "double",
            "description" : "DATABASE, OBJECT_STORAGE：每次 write 平均新增的資料量（bytes），只用來估算儲存量，省略時 DATABASE 為 1000、OBJECT_STORAGE 為 1000000"
          },
          "retentionDays" : {
            "type" : "number",
            "format" : "double",
            "description" : "DATABASE, OBJECT_STORAGE：資料保留天數，只用來估算儲存量，省略時為 365"
          },
          "diskGbPerInstance" : {
            "type" : "number",
            "format" : "double",
            "description" : "DATABASE：每台機器的磁碟容量（GB），省略時不估算磁碟幾天後會滿；OBJECT_STORAGE 給了也忽略"
          }
        }
      },
      "NodeUi" : {
        "type" : "object",
        "properties" : {
          "x" : {
            "type" : "number",
            "format" : "double"
          },
          "y" : {
            "type" : "number",
            "format" : "double"
          }
        },
        "required" : [ "x", "y" ]
      },
      "Topology" : {
        "type" : "object",
        "properties" : {
          "version" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 1
          },
          "nodes" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Node"
            }
          },
          "edges" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Edge"
            }
          }
        },
        "required" : [ "edges", "nodes", "version" ]
      },
      "Bandwidth" : {
        "type" : "object",
        "description" : "使用者端頻寬，單位 bytes/s（spec 4.7）",
        "properties" : {
          "egressBytesPerSec" : {
            "type" : "number",
            "format" : "double",
            "description" : "read 回應送給使用者：read rps × readResponseBytes"
          },
          "ingressBytesPerSec" : {
            "type" : "number",
            "format" : "double",
            "description" : "write 從使用者上傳：write rps × writeRequestBytes"
          }
        },
        "required" : [ "egressBytesPerSec", "ingressBytesPerSec" ]
      },
      "ClassLatencies" : {
        "type" : "object",
        "properties" : {
          "read" : {
            "$ref" : "#/components/schemas/EndToEndLatency"
          },
          "write" : {
            "$ref" : "#/components/schemas/EndToEndLatency"
          }
        },
        "required" : [ "read", "write" ]
      },
      "ClassRates" : {
        "type" : "object",
        "properties" : {
          "read" : {
            "type" : "number",
            "format" : "double"
          },
          "write" : {
            "type" : "number",
            "format" : "double"
          }
        },
        "required" : [ "read", "write" ]
      },
      "EdgeResult" : {
        "type" : "object",
        "properties" : {
          "rps" : {
            "$ref" : "#/components/schemas/ClassRates"
          },
          "backlogRps" : {
            "type" : "number",
            "format" : "double",
            "description" : "Message Queue 的下游邊：consumer 處理不完，queue 每秒增加的訊息數；其他邊為 0"
          },
          "bandwidth" : {
            "description" : "只有 Client 的邊有：這條邊的使用者端頻寬（spec 4.7）",
            "oneOf" : [ {
              "$ref" : "#/components/schemas/Bandwidth"
            }, {
              "type" : "null"
            } ]
          }
        },
        "required" : [ "backlogRps", "bandwidth", "rps" ]
      },
      "EndToEndLatency" : {
        "type" : "object",
        "description" : "一個 request class 的端到端延遲（spec 4.3）",
        "properties" : {
          "ms" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "無定義時為 null，原因見 undefinedReason"
          },
          "approximate" : {
            "type" : "boolean",
            "description" : "路徑上有平行呼叫多個下游，會低估真實延遲；ms 為 null 時一定是 false"
          },
          "overloadedNodeIds" : {
            "type" : "array",
            "description" : "這個 class 實際會走到、而且過載的節點",
            "items" : {
              "type" : "string"
            }
          },
          "undefinedReason" : {
            "type" : [ "string", "null" ],
            "enum" : [ "OVERLOADED", "NO_TRAFFIC" ]
          }
        },
        "required" : [ "approximate", "ms", "overloadedNodeIds", "undefinedReason" ]
      },
      "ExplanationStep" : {
        "type" : "object",
        "description" : "計算說明的一步（spec 4.9）。formula 裡大括號中的符號是代入值，對應 terms 裡同名的項目",
        "properties" : {
          "group" : {
            "type" : "string",
            "description" : "分組標題，例如「到達量」「最熱那台」；同一組的步驟相鄰"
          },
          "label" : {
            "type" : "string"
          },
          "formula" : {
            "type" : "string",
            "description" : "例如 {λ} ÷ ({c} × {μ})"
          },
          "terms" : {
            "type" : "array",
            "description" : "代入值，依在 formula 裡出現的順序",
            "items" : {
              "$ref" : "#/components/schemas/ExplanationTerm"
            }
          },
          "value" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "這一步的結果；沒有定義時為 null（例如過載時的延遲）"
          },
          "unit" : {
            "type" : [ "string", "null" ],
            "description" : "rps、ms、%（0–1 的比例，顯示成百分比）、bytes、days、GB，沒有單位時為 null"
          }
        },
        "required" : [ "formula", "group", "label", "terms", "unit", "value" ]
      },
      "ExplanationTerm" : {
        "type" : "object",
        "description" : "計算說明裡的一個代入值",
        "properties" : {
          "symbol" : {
            "type" : "string",
            "description" : "formula 裡大括號中的符號"
          },
          "value" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "沒有定義時為 null（例如下游過載時的端到端延遲）"
          },
          "unit" : {
            "type" : [ "string", "null" ],
            "description" : "同 ExplanationStep.unit"
          },
          "nodeId" : {
            "type" : [ "string", "null" ],
            "description" : "這個值來自另一個節點時是那個節點的 id，前端可以點過去"
          }
        },
        "required" : [ "nodeId", "symbol", "unit", "value" ]
      },
      "HotSpot" : {
        "type" : "object",
        "properties" : {
          "hottest" : {
            "$ref" : "#/components/schemas/InstanceResult",
            "description" : "最熱的那台"
          },
          "others" : {
            "$ref" : "#/components/schemas/InstanceResult",
            "description" : "其他台合起來（共用一條佇列）"
          }
        },
        "required" : [ "hottest", "others" ]
      },
      "InstanceResult" : {
        "type" : "object",
        "description" : "節點裡一部分機器的結果，欄位意義同 NodeResult；多台時是合起來的流量，ρ 是每台相同的使用率",
        "properties" : {
          "arrivalRps" : {
            "$ref" : "#/components/schemas/ClassRates"
          },
          "throughputRps" : {
            "type" : "number",
            "format" : "double"
          },
          "droppedRps" : {
            "type" : "number",
            "format" : "double"
          },
          "utilization" : {
            "type" : "number",
            "format" : "double"
          },
          "avgLatencyMs" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "過載時為 null"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "OK", "WARN", "CRITICAL", "OVERLOADED", "LIMITING", "NOT_LIMITING", "OVER_QUOTA", "WITHIN_QUOTA" ]
          }
        },
        "required" : [ "arrivalRps", "avgLatencyMs", "droppedRps", "status", "throughputRps", "utilization" ]
      },
      "NodeResult" : {
        "type" : "object",
        "properties" : {
          "arrivalRps" : {
            "$ref" : "#/components/schemas/ClassRates"
          },
          "throughputRps" : {
            "type" : "number",
            "format" : "double"
          },
          "droppedRps" : {
            "type" : "number",
            "format" : "double",
            "description" : "超過容量、沒被處理的請求數"
          },
          "rejectedRps" : {
            "type" : "number",
            "format" : "double",
            "description" : "Rate Limiter 超過 limitRps、External API 超過 quotaRps 拒絕的請求數，其他節點為 0"
          },
          "successRps" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "只有 Client 有：這個 Client 的請求每秒有幾個完整成功（spec 4.3.1）"
          },
          "endToEndMs" : {
            "description" : "只有 Client 有",
            "oneOf" : [ {
              "$ref" : "#/components/schemas/ClassLatencies"
            }, {
              "type" : "null"
            } ]
          },
          "capacityRps" : {
            "type" : [ "number", "null" ],
            "format" : "double"
          },
          "utilization" : {
            "type" : [ "number", "null" ],
            "format" : "double"
          },
          "avgQueueMs" : {
            "type" : [ "number", "null" ],
            "format" : "double"
          },
          "avgLatencyMs" : {
            "type" : [ "number", "null" ],
            "format" : "double"
          },
          "status" : {
            "type" : [ "string", "null" ],
            "enum" : [ "OK", "WARN", "CRITICAL", "OVERLOADED", "LIMITING", "NOT_LIMITING", "OVER_QUOTA", "WITHIN_QUOTA" ]
          },
          "hotSpot" : {
            "description" : "只有設定了 hotShare 的 Cache 有：最熱的那台和其他台的結果（spec 4.2.2）",
            "oneOf" : [ {
              "$ref" : "#/components/schemas/HotSpot"
            }, {
              "type" : "null"
            } ]
          },
          "warnings" : {
            "type" : "array",
            "description" : "沒有警告時為空陣列；REPLICATION_LAG：Read Replica 丟掉了複製寫入（spec 4.2.3）；BACKLOG：consumer 處理不完 Message Queue 的訊息（spec 4.2.4）",
            "items" : {
              "type" : "string",
              "enum" : [ "REPLICATION_LAG", "BACKLOG" ]
            }
          },
          "explanation" : {
            "type" : "array",
            "description" : "計算步驟（spec 4.9），依計算順序；未連線的節點為空陣列",
            "items" : {
              "$ref" : "#/components/schemas/ExplanationStep"
            }
          }
        },
        "required" : [ "arrivalRps", "avgLatencyMs", "avgQueueMs", "capacityRps", "droppedRps", "endToEndMs", "explanation", "hotSpot", "rejectedRps", "status", "successRps", "throughputRps", "utilization", "warnings" ]
      },
      "SimulationResult" : {
        "type" : "object",
        "properties" : {
          "valid" : {
            "type" : "boolean"
          },
          "errors" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ValidationError"
            }
          },
          "nodes" : {
            "type" : "object",
            "additionalProperties" : {
              "$ref" : "#/components/schemas/NodeResult"
            }
          },
          "edges" : {
            "type" : "object",
            "additionalProperties" : {
              "$ref" : "#/components/schemas/EdgeResult"
            }
          },
          "summary" : {
            "description" : "驗證失敗時為 null",
            "oneOf" : [ {
              "$ref" : "#/components/schemas/Summary"
            }, {
              "type" : "null"
            } ]
          },
          "storage" : {
            "type" : "object",
            "additionalProperties" : {
              "$ref" : "#/components/schemas/StorageEstimate"
            },
            "description" : "Database、Object Storage 的儲存量估算（spec 4.8），以節點 id 為 key；驗證失敗時為 {}"
          }
        },
        "required" : [ "edges", "errors", "nodes", "storage", "summary", "valid" ]
      },
      "StorageEstimate" : {
        "type" : "object",
        "description" : "一個儲存節點的儲存量估算，單位 bytes（spec 4.8）",
        "properties" : {
          "dailyBytes" : {
            "type" : "number",
            "format" : "double",
            "description" : "成功處理的 write × bytesPerWrite × 86400"
          },
          "totalBytes" : {
            "type" : "number",
            "format" : "double",
            "description" : "dailyBytes × retentionDays"
          },
          "replicas" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "連到這個 Database 的 Read Replica 數"
          },
          "totalWithReplicasBytes" : {
            "type" : "number",
            "format" : "double",
            "description" : "totalBytes × (1 + replicas)"
          },
          "replicasLagging" : {
            "type" : "boolean",
            "description" : "有 Read Replica 複製跟不上（REPLICATION_LAG），實際副本量會比 totalWithReplicasBytes 少"
          },
          "perInstanceBytes" : {
            "type" : "number",
            "format" : "double",
            "description" : "totalBytes ÷ instances（資料平均分布）"
          },
          "daysUntilFull" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "每台機器的磁碟幾天後會滿；OBJECT_STORAGE、沒有設定 diskGbPerInstance、沒有寫入或寫入量小到天數超出範圍時為 null"
          },
          "fillsDisk" : {
            "type" : "boolean",
            "description" : "磁碟在保留期內就會滿（daysUntilFull < retentionDays）"
          },
          "retentionDays" : {
            "type" : "number",
            "format" : "double",
            "description" : "計算時用的 retentionDays"
          },
          "diskGbPerInstance" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "計算時用的 diskGbPerInstance，沒有設定時和 OBJECT_STORAGE 為 null"
          },
          "explanation" : {
            "type" : "array",
            "description" : "計算步驟（spec 4.9），格式同 NodeResult.explanation；未連線的節點為空陣列",
            "items" : {
              "$ref" : "#/components/schemas/ExplanationStep"
            }
          }
        },
        "required" : [ "dailyBytes", "daysUntilFull", "diskGbPerInstance", "explanation", "fillsDisk", "perInstanceBytes", "replicas", "replicasLagging", "retentionDays", "totalBytes", "totalWithReplicasBytes" ]
      },
      "Summary" : {
        "type" : "object",
        "properties" : {
          "offeredRps" : {
            "type" : "number",
            "format" : "double"
          },
          "successRps" : {
            "type" : "number",
            "format" : "double",
            "description" : "各 Client 完整成功的請求數總和"
          },
          "rejectedRps" : {
            "type" : "number",
            "format" : "double",
            "description" : "各節點拒絕量的總和"
          },
          "dropRate" : {
            "type" : "number",
            "format" : "double",
            "description" : "1 − successRps / offeredRps（丟棄和拒絕都算），限制在 [0, 1]，浮點誤差造成的極小值歸零；沒有流量時為 0"
          },
          "avgEndToEndMs" : {
            "$ref" : "#/components/schemas/ClassLatencies"
          },
          "bottleneckNodeId" : {
            "type" : [ "string", "null" ]
          },
          "bandwidth" : {
            "$ref" : "#/components/schemas/Bandwidth",
            "description" : "各 Client 的使用者端頻寬總和"
          },
          "cdnOffloadBytesPerSec" : {
            "type" : "number",
            "format" : "double",
            "description" : "egressBytesPerSec 裡由 CDN 命中送出、不必從 origin 送出的部分"
          }
        },
        "required" : [ "avgEndToEndMs", "bandwidth", "bottleneckNodeId", "cdnOffloadBytesPerSec", "dropRate", "offeredRps", "rejectedRps", "successRps" ]
      },
      "ValidationError" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "nodeId" : {
            "type" : [ "string", "null" ]
          },
          "edgeId" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "code", "edgeId", "message", "nodeId" ]
      }
    }
  }
}
